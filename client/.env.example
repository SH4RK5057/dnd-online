# Comma-separated list of y-webrtc signaling server WebSocket URLs.
# For local dev, run `npm run dev` in ../server and use the default below.
# For a deployed session, swap in your Render/Fly.io wss:// URL.
VITE_SIGNALING_URLS=ws://localhost:4444

# Optional default URL for a DM's own private 5etools-2014-src-shaped content
# mirror (never bundled/hosted by this app — see client/src/content/). Leave
# unset to skip this default; a DM can still type one in at runtime from the
# compendium's mirror-import panel, or import local files instead.
VITE_5ETOOLS_MIRROR_URL=
